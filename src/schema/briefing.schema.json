{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Briefing",
  "description": "A structured briefing published by an agent to the Briefing Hub",
  "type": "object",
  "required": ["title", "source", "cards"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "source": {
      "type": "object",
      "required": ["name", "mark", "tone"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mark": { "type": "string", "minLength": 1, "maxLength": 2 },
        "tone": { "type": "string", "enum": ["blue", "lime", "coral", "yellow"] }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["type", "priority", "title", "summary", "body", "meta"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["action", "information", "warning", "result"] },
          "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "body": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "maxLength": 2000 }
          },
          "content": {
            "description": "Optional editorial blocks chosen by the producer. The renderer controls their final visual style.",
            "type": "array",
            "maxItems": 6,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["kind", "value", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "const": "metric" },
                    "value": { "type": "string", "minLength": 1, "maxLength": 16 },
                    "label": { "type": "string", "minLength": 1, "maxLength": 70 },
                    "detail": { "type": "string", "maxLength": 180 },
                    "tone": { "$ref": "#/definitions/contentTone" }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind", "left", "right"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "const": "comparison" },
                    "title": { "type": "string", "maxLength": 70 },
                    "left": { "$ref": "#/definitions/comparisonSide" },
                    "right": { "$ref": "#/definitions/comparisonSide" }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind", "title", "items"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "const": "bullets" },
                    "title": { "type": "string", "minLength": 1, "maxLength": 70 },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 7,
                      "items": {
                        "type": "object",
                        "required": ["text"],
                        "additionalProperties": false,
                        "properties": {
                          "text": { "type": "string", "minLength": 1, "maxLength": 240 },
                          "tone": { "$ref": "#/definitions/contentTone" }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind", "title", "items"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "const": "bar_chart" },
                    "title": { "type": "string", "minLength": 1, "maxLength": 70 },
                    "caption": { "type": "string", "maxLength": 100 },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "required": ["label", "value"],
                        "additionalProperties": false,
                        "properties": {
                          "label": { "type": "string", "minLength": 1, "maxLength": 70 },
                          "value": { "type": "number", "minimum": 0 },
                          "max": { "type": "number", "exclusiveMinimum": 0 },
                          "display": { "type": "string", "maxLength": 30 },
                          "tone": { "$ref": "#/definitions/contentTone" }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind", "title", "text"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "const": "callout" },
                    "label": { "type": "string", "maxLength": 50 },
                    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "text": { "type": "string", "minLength": 1, "maxLength": 420 },
                    "tone": { "$ref": "#/definitions/contentTone" }
                  }
                }
              ]
            }
          },
          "meta": { "type": "string", "maxLength": 100 },
          "action_label": { "type": "string", "maxLength": 100 },
          "reference": { "type": "string", "maxLength": 100 },
          "action_job_type": { "type": "string", "maxLength": 100 },
          "action_job_title": { "type": "string", "maxLength": 300 },
          "action_job_input": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  },
  "definitions": {
    "contentTone": {
      "type": "string",
      "enum": ["blue", "lime", "coral", "yellow", "neutral"]
    },
    "comparisonSide": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 50 },
        "value": { "type": "string", "minLength": 1, "maxLength": 180 },
        "tone": { "$ref": "#/definitions/contentTone" }
      }
    }
  }
}
