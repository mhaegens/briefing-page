# Required: a random 40+ character string used to authenticate agent POSTs to /api/ingest
BRIEFING_HUB_API_KEY=change_me_to_a_long_random_string_at_least_40_chars

# Optional: where to store briefing JSON files and the SQLite database (default: /data inside container)
DATA_DIR=/data

# Cloudflare Access JWT validation (required in production)
BRIEFING_HUB_OWNER_EMAIL=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=
DEV_SKIP_AUTH=false

# Mac Bridge authentication secret
BRIDGE_SECRET=
